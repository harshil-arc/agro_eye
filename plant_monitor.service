[Unit]
Description=Raspberry Pi Plant Detection and Monitoring System (100% Offline YOLOv8)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/plant_system
ExecStart=/home/pi/plant_system/venv/bin/python main.py
Restart=always
RestartSec=10
Environment=ENABLE_GUI_DISPLAY=False
Environment=YOLO_MODEL_PATH=models/disease_model.pt

[Install]
WantedBy=multi-user.target
