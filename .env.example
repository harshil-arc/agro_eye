# ============================================================
# Plant Detection System - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ============================================================

# --- 100% Offline YOLOv8 AI Model Configuration ---
YOLO_MODEL_PATH=models/disease_model.pt
CONFIDENCE_THRESHOLD=0.15

# --- Animal & Wildlife Intrusion AI Model Configuration ---
ANIMAL_MODEL_PATH=D:\animal_detection_model\yolo11m.pt
ANIMAL_CONF_THRESHOLD=0.35
ENABLE_ANIMAL_DETECTION=True

# --- Camera Selection ---
# 0 = Default/Laptop Webcam, 1 = External USB Camera
CAMERA_INDEX=1

# --- Firebase Configuration ---
FIREBASE_CREDENTIALS=config/service_account.json
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com/
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# --- Hardware / Port Settings ---
ESP32_PORT=/dev/ttyUSB0
ESP32_BAUDRATE=9600

LORA_FREQ=433000000
LORA_SF=7
LORA_BW=125
LORA_POWER=17

# --- Operating Flags ---
ENABLE_GUI_DISPLAY=True
