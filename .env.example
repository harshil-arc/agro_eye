# ============================================================
# Plant Detection System - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# ============================================================

# --- Roboflow AI Model Configuration ---
ROBOFLOW_API_KEY=YOUR_ROBOFLOW_API_KEY_HERE
ROBOFLOW_MODEL_ID=detecting-diseases/5
ROBOFLOW_API_URL=https://detect.roboflow.com
CONFIDENCE_THRESHOLD=0.55
INFERENCE_INTERVAL=0.5

# --- Firebase Configuration ---
FIREBASE_CREDENTIALS=config/service_account.json
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com/
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# --- Hardware / Port Settings ---
ESP32_PORT=/dev/ttyUSB0
ESP32_BAUDRATE=115200

LORA_PORT=/dev/serial0
LORA_BAUDRATE=115200
LORA_TARGET_ADDR=100

NPK_PORT=/dev/ttyUSB1
NPK_BAUDRATE=9600
NPK_SLAVE_ADDR=1

# --- Operating Flags ---
MOCK_SENSORS=False
MOCK_LORA=False
ENABLE_GUI_DISPLAY=True
